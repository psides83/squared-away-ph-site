NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production scheduler only. Never use NEXT_PUBLIC_ for these secrets.
# Set a random CRON_SECRET of at least 32 characters in Vercel Production.
CRON_SECRET=
# Supply either the current Supabase server secret or legacy service-role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for password recovery, e.g. https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Administrator device push. Generate one persistent pair with npm run setup:push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://squaredawayperformancehorses.vercel.app

# Optional frequent notification checks, separate from daily billing.
# Match this separate 32+-character secret to saph_push_cron_secret in Supabase Vault.
PUSH_CRON_SECRET=
# Set to 1 only when the production frequent-check scheduler is configured.
PUSH_FREQUENT_CHECKS=0
